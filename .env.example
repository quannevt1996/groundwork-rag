# Copy to .env (git-ignored) and uncomment what you need. Everything is optional:
# with no .env the app runs locally on embedded Postgres (PGlite) and a local
# embedding model, in retrieval-only mode.

# --- Answers ---------------------------------------------------------------
# Lets Claude write cited answers. Without it, retrieval and the inspector still work.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# One of: low, medium, high, xhigh, max
# ANTHROPIC_EFFORT=medium

# --- Database --------------------------------------------------------------
# Default: embedded PGlite stored in data/pglite. To use a Postgres server instead
# (it needs the pgvector extension available):
# DATABASE_URL=postgres://user:password@localhost:5432/groundwork
# Absolute path for the embedded database:
# PGLITE_DATA_DIR=/absolute/path/to/data/pglite

# --- Embeddings ------------------------------------------------------------
# local (default): bge-small-en-v1.5 via ONNX Runtime, downloaded once (~130 MB).
# voyage: Voyage AI API. hash: no semantics, for tests and offline CI only.
# The embedder is pinned in the database; switching needs a fresh database.
# EMBEDDER=local
# LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# MODEL_CACHE_DIR=/absolute/path/to/.cache/models
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite
# EMBEDDING_DIM=1024

# --- Retrieval -------------------------------------------------------------
# Chunks retrieved per question.
# RETRIEVAL_TOP_K=8
# all: every keyword must match (default). any: OR of keywords. See README.
# KEYWORD_MATCH=all
# Below this cosine similarity, with no keyword match, answer "not found" without calling the model.
# MIN_VECTOR_SIMILARITY=0.55

# PORT=8787
